{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/dist/cli.js",
              "claude-hook"
            ],
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
