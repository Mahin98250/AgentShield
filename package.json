{
  "name": "agentshield",
  "version": "0.1.0",
  "description": "Local-first policy guard for AI coding agents",
  "type": "module",
  "bin": {
    "agentshield": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "rules",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/engine.test.js",
    "check": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "security",
    "ai-agents",
    "coding-agents",
    "cli",
    "policy-engine"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mahin98250/AgentShield.git"
  },
  "homepage": "https://github.com/Mahin98250/AgentShield#readme",
  "bugs": {
    "url": "https://github.com/Mahin98250/AgentShield/issues"
  }
}
